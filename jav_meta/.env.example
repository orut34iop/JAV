# JAV Meta Configuration
# Copy this file to .env and fill in your values

# JavBus settings
JAVBUS_BASE_URL=https://www.javbus.com
JAVBUS_UNCENSORED_URL=https://www.javbus.com/uncensored
# Paste your browser cookie here (e.g. from Chrome DevTools)
JAVBUS_COOKIE=existmag=all; __cfduid=xxx; others=...

# Paths (relative to project root)
DATA_DIR=data
DB_PATH=data/db.sqlite3
DUMPS_DIR=data/dumps
IMAGES_DIR=data/images
COVERS_DIR=data/images/covers
POSTERS_DIR=data/images/posters
SCREENSHOTS_DIR=data/images/screenshots
ACTRESSES_DIR=data/images/actresses

# Crawler settings
CONCURRENCY=8
ADAPTIVE_CONCURRENCY=true
REQUEST_TIMEOUT=30.0
MAX_RETRIES=3
PROGRESS_INTERVAL_SECONDS=180
DUMP_INTERVAL_PAGES=50

# Proxy (optional)
# PROXY_URL=http://127.0.0.1:1080
